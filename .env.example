# Ambiente
DCE_ENV=HOMOLOGACAO
DCE_VERSION=1.00
DCE_UF=RS
DCE_CUF=43

# Dados do Emissor
DCE_CNPJ=
DCE_RAZAO_SOCIAL=
DCE_LOGRADOURO=RUA EXEMPLO
DCE_NUMERO=1
DCE_COMPLEMENTO=
DCE_BAIRRO=CENTRO
DCE_MUNICIPIO_IBGE=
DCE_MUNICIPIO=
DCE_CEP=
DCE_SERIE=0
DCE_START_NUMBER=1

# Certificado A1 ICP-Brasil
# Nunca comitar o arquivo .pfx nem a senha real
DCE_CERT_PATH=certs/certificado.pfx
DCE_CERT_PASSWORD=
DCE_CA_BUNDLE=

# Schema XSD oficial
# Coloque o arquivo DCe_v1.00.xsd em schemas/ antes de validar
DCE_SCHEMA_PATH=schemas/DCe_v1.00.xsd

# URLs Web Services — SVRS (Sefaz Virtual RS, gerenciada pelo PR)
# Homologação:
DCE_AUTHORIZATION_URL=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeAutorizacao
DCE_QUERY_URL=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeConsulta
DCE_STATUS_URL=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeStatusServico
DCE_EVENT_URL=https://homologacao.dce.fazenda.pr.gov.br/dce/DCeRecepcaoEvento

# Produção (comentado — não alterar sem credenciamento real):
# DCE_AUTHORIZATION_URL=https://dce.fazenda.pr.gov.br/dce/DCeAutorizacao
# DCE_QUERY_URL=https://dce.fazenda.pr.gov.br/dce/DCeConsulta
# DCE_STATUS_URL=https://dce.fazenda.pr.gov.br/dce/DCeStatusServico
# DCE_EVENT_URL=https://dce.fazenda.pr.gov.br/dce/DCeRecepcaoEvento

# QR-Code / DACE
DCE_QRCODE_BASEURL=https://www.fazenda.pr.gov.br/dce/qrcode
DCE_CHAVE_URL=https://www.fazenda.pr.gov.br/dce/qrcode

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg://opendce:opendce@localhost:5432/opendce

# App
APP_HOST=0.0.0.0
APP_PORT=7777
LOG_LEVEL=INFO

# Feature flags (false = não implementado ainda)
DCE_FEATURE_DACE=false
DCE_FEATURE_QRCODE=false
DCE_FEATURE_CANCELAMENTO=false
DCE_FEATURE_CONTINGENCIA=false
